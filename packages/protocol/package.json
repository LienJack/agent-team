{
  "name": "@agent-team/protocol",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "src",
    "openapi.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@agent-team/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "@agent-team/source": "./src/constants.ts",
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "generate": "tsx --conditions=@agent-team/source src/scripts/generate-openapi.ts",
    "check:generated": "tsx --conditions=@agent-team/source src/scripts/generate-openapi.ts --check"
  },
  "dependencies": {
    "@agent-team/schema": "workspace:*",
    "@hono/zod-openapi": "1.6.3",
    "hono": "4.13.19",
    "zod": "4.6.7"
  }
}
