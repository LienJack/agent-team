{
  "name": "@agent-team/runners",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@agent-team/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@agent-team/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "test": "vitest run --root ../.. --project runners",
    "test:smoke": "TEAM_SMOKE=1 vitest run --config test/smoke/vitest.config.ts"
  },
  "dependencies": {
    "@agent-team/core": "workspace:*",
    "@agent-team/schema": "workspace:*",
    "@openai/codex-sdk": "0.171.0"
  }
}
