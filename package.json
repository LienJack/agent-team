{
  "name": "agent-team",
  "version": "0.0.0",
  "private": true,
  "description": "本機多 agent 開發服務（見 docs/spec.md）",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "tsc -b --force",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "clean": "tsc -b --clean",
    "hooks:install": "husky"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,mjs,cjs}": [
      "oxlint --deny-warnings --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,yml,yaml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.25.0"
}
